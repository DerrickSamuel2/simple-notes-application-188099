{
  "name": "notes-app-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node -e \"process.exit(0)\"",
    "dev": "node scripts/dev.js",
    "dev:preview": "node scripts/dev.js",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 HOST=0.0.0.0 PORT=3000 next start -p ${PORT:-3000}",
    "lint": "next lint",
    "clean": "node -e \"import('node:fs').then(fs=>{fs.rmSync('.next',{recursive:true,force:true}); try{fs.rmSync('node_modules/.cache',{recursive:true,force:true});}catch{}})\"",
    "dev:clean": "npm run clean && node scripts/dev.js",
    "rebuild": "npm run clean && cross-env NEXT_TELEMETRY_DISABLED=1 next build"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5"
  }
}
